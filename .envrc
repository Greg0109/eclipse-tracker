#!/usr/bin/env bash
set -euo pipefail

log_warning() {
    log_status "WARNING: $*" >&2
}

check_just_available() {
    if ! command -v just >/dev/null 2>&1; then
        log_error "'just' command runner is not installed"
        log_error "Please install just first: https://github.com/casey/just#installation"
        return 1
    fi
}

load_dotenv_local() {
    if [[ -f ".env" ]]; then
        dotenv ".env"
    fi
}

configure_uv_authentication() {
    # No private index authentication needed - using public PyPI
    :
}

setup_python_environment() {
    just setup-env
}

activate_virtual_environment() {
    if [[ -d ".venv" ]]; then
        source .venv/bin/activate
        PATH_add ".venv/bin"
        export VIRTUAL_ENV="$PWD/.venv"
        log_status "Virtual environment activated by direnv"
    fi
}

usage() {
    log_status "===================== ENVIRONMENT READY ========================"
    log_status "  just --list              # Show all available tasks"
    log_status "  just serve               # Start development server"
    log_status "  just test                # Run tests"
    log_status "  just docs                # Build documentation"
    log_status "  just docker-shell        # Open Docker shell with same CI environment"
    log_status "==============================================================="
}

main() {
    check_just_available
    load_dotenv_local
    configure_uv_authentication
    setup_python_environment
    activate_virtual_environment
    usage
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]] || [[ -n "${DIRENV_IN_ENVRC:-}" ]]; then
    main
fi
